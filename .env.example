# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# SINE-PI Integration Environment Variables
SINE_SOURCE_URL="https://portal.pi.gov.br/sine/vagas-de-emprego/"
CRON_SECRET="your_secure_cron_secret_here"

# Firebase Client Configuration (Required for Render deployment)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"


